  generation      Generation    @relation(fields: [generationId, tenantId, locationId, reviewSessionId], references: [id, tenantId, locationId, reviewSessionId], onDelete: Restrict)

  @@unique([generationId, ordinal])
  @@index([tenantId, locationId, reviewSessionId])
  @@map("unsupported_outputs")
}

model Draft {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String          @map("tenant_id") @db.Uuid
  locationId              String          @map("location_id") @db.Uuid
  reviewSessionId         String          @map("review_session_id") @db.Uuid
  originatingGenerationId String          @unique @map("originating_generation_id") @db.Uuid
  status                  DraftStatus     @default(ACTIVE)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location                Location        @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reviewSession           ReviewSession   @relation(fields: [reviewSessionId, tenantId, locationId], references: [id, tenantId, locationId], onDelete: Restrict)
  originatingGeneration   Generation      @relation(fields: [originatingGenerationId, tenantId, locationId, reviewSessionId], references: [id, tenantId, locationId, reviewSessionId], onDelete: Restrict)
  revisions               DraftRevision[]
  disposition             Disposition?

  @@unique([id, tenantId, locationId, reviewSessionId])
  @@unique([originatingGenerationId, tenantId, locationId, reviewSessionId])
  @@index([tenantId, locationId, reviewSessionId])
  @@map("drafts")
}

model DraftRevision {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String              @map("tenant_id") @db.Uuid
  locationId             String              @map("location_id") @db.Uuid
  reviewSessionId        String              @map("review_session_id") @db.Uuid
  draftId                String              @map("draft_id") @db.Uuid
  sourceGenerationId     String?             @map("source_generation_id") @db.Uuid
  revision               Int
  author                 DraftRevisionAuthor
  text                   String
  contentHash            String              @map("content_hash") @db.VarChar(128)
  annotations            Json                @default("{}")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location               Location            @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reviewSession          ReviewSession       @relation(fields: [reviewSessionId, tenantId, locationId], references: [id, tenantId, locationId], onDelete: Restrict)
  draft                  Draft               @relation(fields: [draftId, tenantId, locationId, reviewSessionId], references: [id, tenantId, locationId, reviewSessionId], onDelete: Restrict)
  sourceGeneration       Generation?         @relation("RevisionSourceGeneration", fields: [sourceGenerationId, tenantId, locationId, reviewSessionId], references: [id, tenantId, locationId, reviewSessionId], onDelete: Restrict)
  selectedByDispositions Disposition[]

  @@unique([draftId, revision])
  @@unique([id, draftId, tenantId, locationId, reviewSessionId])
  @@index([tenantId, locationId, reviewSessionId])
  @@map("draft_revisions")
}

model Disposition {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String          @map("tenant_id") @db.Uuid
  locationId              String          @map("location_id") @db.Uuid
  reviewSessionId         String          @map("review_session_id") @db.Uuid
  draftId                 String          @unique @map("draft_id") @db.Uuid
  generationId            String          @map("generation_id") @db.Uuid
  selectedDraftRevisionId String?         @map("selected_draft_revision_id") @db.Uuid
  kind                    DispositionKind
  normalizedEditDistance  Decimal?        @map("normalized_edit_distance") @db.Decimal(8, 6)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location                Location        @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reviewSession           ReviewSession   @relation(fields: [reviewSessionId, tenantId, locationId], references: [id, tenantId, locationId], onDelete: Restrict)
  draft                   Draft           @relation(fields: [draftId, tenantId, locationId, reviewSessionId], references: [id, tenantId, locationId, reviewSessionId], onDelete: Restrict)
  generation              Generation      @relation(fields: [generationId, tenantId, locationId, reviewSessionId], references: [id, tenantId, locationId, reviewSessionId], onDelete: Restrict)
  selectedDraftRevision   DraftRevision?  @relation(fields: [selectedDraftRevisionId, draftId, tenantId, locationId, reviewSessionId], references: [id, draftId, tenantId, locationId, reviewSessionId], onDelete: Restrict)

  @@unique([draftId, tenantId, locationId, reviewSessionId])
  @@index([tenantId, locationId, reviewSessionId])
  @@map("dispositions")
}
