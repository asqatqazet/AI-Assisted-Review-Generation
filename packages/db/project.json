{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "db",
  "root": "packages/db",
  "sourceRoot": "packages/db/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/db"],
      "options": { "command": "tsup packages/db/src/control-plane/index.ts packages/db/src/admission/index.ts packages/db/src/execution-plane/index.ts --format esm --out-dir dist/packages/db --clean" }
    },
    "reset": {
      "executor": "nx:run-commands",
      "options": { "command": "prisma migrate reset --force --schema packages/db/prisma/schema.prisma" }
    }
  },
  "tags": ["type:adapter", "io:database"]
}
