POSTGRES_DB=assisted_reviews
POSTGRES_USER=review_owner
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgresql://review_owner:local_only_change_me@localhost:5432/assisted_reviews
# `pnpm dev` uses DATABASE_URL only for migrations/seeding. It then assigns
# random passwords and passes an exact service-role URL to each process. Never
# copy the owner URL into any of these runtime variables when starting a
# service by itself:
# CONTEXT_RUNTIME_DATABASE_URL=postgresql://context_runtime_svc:<runtime-password>@127.0.0.1:5432/assisted_reviews
# CONSOLE_CONTROL_DATABASE_URL=postgresql://console_control_svc:<console-password>@127.0.0.1:5432/assisted_reviews
# GENERATION_DATABASE_URL=postgresql://generation_svc:<generation-password>@127.0.0.1:5432/assisted_reviews

CONTEXT_REVIEWER_ORIGIN=http://127.0.0.1:3001
CONTEXT_CONSOLE_ORIGIN=http://127.0.0.1:3003
GENERATION_SERVICE_ORIGIN=http://127.0.0.1:3002
# Optional, funded provider credentials. Leaving both blank keeps local
# development on the snapshot-routed FakeProvider and cannot make a paid call.
GEMINI_API_KEY=
OPENAI_API_KEY=
