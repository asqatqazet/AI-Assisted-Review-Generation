{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "generation-service",
  "root": "apps/generation-service",
  "sourceRoot": "apps/generation-service/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "PORT=3002 tsx watch apps/generation-service/dev.ts" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/generation-service"],
      "options": {
        "commands": [
          "tsup apps/generation-service/src/main.ts --format esm --config infra/aws/lambda-server.tsup.config.ts --out-dir dist/apps/generation-service --clean",
          "node --no-experimental-detect-module --input-type=module --eval \"await import('./dist/apps/generation-service/main.js')\""
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:deployable", "plane:execution"]
}
