{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web-bff",
  "root": "apps/web-bff",
  "sourceRoot": "apps/web-bff/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx watch apps/web-bff/dev.ts" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/web-bff"],
      "options": {
        "commands": [
          "tsup apps/web-bff/src/main.ts apps/web-bff/src/stream-main.ts apps/web-bff/src/reconcile-main.ts --format esm --out-dir dist/apps/web-bff --clean",
          "vite build apps/web-bff --config apps/web-bff/vite.config.ts"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:deployable", "plane:edge"]
}
