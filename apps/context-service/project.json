{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "context-service",
  "root": "apps/context-service",
  "sourceRoot": "apps/context-service/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "PORT=3001 tsx watch apps/context-service/dev.ts" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/context-service"],
      "options": {
        "commands": [
          "tsup apps/context-service/src/main.ts --format esm --config infra/aws/lambda-server.tsup.config.ts --out-dir dist/apps/context-service --clean",
          "node --no-experimental-detect-module --input-type=module --eval \"await import('./dist/apps/context-service/main.js')\""
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:deployable", "plane:control"]
}
