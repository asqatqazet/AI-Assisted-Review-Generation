{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/content/**",
              "components/editorial/**",
              "components/forms/**",
              "components/media/**",
              "components/site/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Space Grotesk|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Space Grotesk, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentConsoleResponse'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|lines|bars|key|ref|className|style|children)$/]",
        "message": "<AgentConsoleResponse> doesn't accept that prop. Declared props: title, lines, bars."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncementBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|linkLabel|linkHref|dismissible|onClose|style|key|ref|className|style|children)$/]",
        "message": "<AnnouncementBar> doesn't accept that prop. Declared props: children, linkLabel, linkHref, dismissible, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlogFilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|size|count|onClick|href|style|key|ref|className|style|children)$/]",
        "message": "<BlogFilterChip> doesn't accept that prop. Declared props: children, active, size, count, onClick, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlogFilterChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md)$/]",
        "message": "<BlogFilterChip> size must be one of 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonPillOutline'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|selected|onSurface|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ButtonPillOutline> doesn't accept that prop. Declared props: children, href, selected, onSurface, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonPillOutline'] > JSXAttribute[name.name='onSurface'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ButtonPillOutline> onSurface must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonPrimary'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onSurface|size|disabled|fullWidth|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ButtonPrimary> doesn't accept that prop. Declared props: children, href, onSurface, size, disabled, fullWidth, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonPrimary'] > JSXAttribute[name.name='onSurface'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ButtonPrimary> onSurface must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonPrimary'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ButtonPrimary> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonPrimary'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<ButtonPrimary> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonSecondary'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onSurface|underline|withArrow|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ButtonSecondary> doesn't accept that prop. Declared props: children, href, onSurface, underline, withArrow, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonSecondary'] > JSXAttribute[name.name='onSurface'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ButtonSecondary> onSurface must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonSecondary'] > JSXAttribute[name.name='underline'] > Literal[value!=/^(?:always|hover|never)$/]",
        "message": "<ButtonSecondary> underline must be one of 'always' | 'hover' | 'never'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonSecondary'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<ButtonSecondary> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CapabilityCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|icon|title|body|linkLabel|href|variant|onSurface|style|key|ref|className|style|children)$/]",
        "message": "<CapabilityCard> doesn't accept that prop. Declared props: eyebrow, icon, title, body, linkLabel, href, variant, onSurface, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CapabilityCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:rule|plain|boxed)$/]",
        "message": "<CapabilityCard> variant must be one of 'rule' | 'plain' | 'boxed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CapabilityCard'] > JSXAttribute[name.name='onSurface'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<CapabilityCard> onSurface must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactFormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|type|placeholder|required|span|rows|options|key|ref|className|style|children)$/]",
        "message": "<ContactFormField> doesn't accept that prop. Declared props: name, label, type, placeholder, required, span, rows, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactFormField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel|url|textarea|select)$/]",
        "message": "<ContactFormField> type must be one of 'text' | 'email' | 'tel' | 'url' | 'textarea' | 'select'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DarkFeatureBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|eyebrow|title|body|actions|media|children|layout|inset|style|key|ref|className|style|children)$/]",
        "message": "<DarkFeatureBand> doesn't accept that prop. Declared props: tone, eyebrow, title, body, actions, media, children, layout, inset, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DarkFeatureBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:indigo|clay|ink)$/]",
        "message": "<DarkFeatureBand> tone must be one of 'indigo' | 'clay' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DarkFeatureBand'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stack|split)$/]",
        "message": "<DarkFeatureBand> layout must be one of 'stack' | 'split'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: label, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroPhotoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|tone|radius|ratio|label|caption|overlay|overlayPosition|children|style|key|ref|className|style|children)$/]",
        "message": "<HeroPhotoCard> doesn't accept that prop. Declared props: src, alt, tone, radius, ratio, label, caption, overlay, overlayPosition, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroPhotoCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:chalk|sand|lilac|indigo|clay|ink)$/]",
        "message": "<HeroPhotoCard> tone must be one of 'chalk' | 'sand' | 'lilac' | 'indigo' | 'clay' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroPhotoCard'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:xs|sm|md|lg)$/]",
        "message": "<HeroPhotoCard> radius must be one of 'xs' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroPhotoCard'] > JSXAttribute[name.name='overlayPosition'] > Literal[value!=/^(?:bottom-left|bottom-right|top-left|center)$/]",
        "message": "<HeroPhotoCard> overlayPosition must be one of 'bottom-left' | 'bottom-right' | 'top-left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|description|actionLabel|actionHref|onAction|features|tone|featured|style|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: eyebrow, title, description, actionLabel, actionHref, onAction, features, tone, featured, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:chalk|sand|lilac|canvas|ink|indigo|clay)$/]",
        "message": "<ProductCard> tone must be one of 'chalk' | 'sand' | 'lilac' | 'canvas' | 'ink' | 'indigo' | 'clay'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResearchRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|href|authors|topics|date|key|ref|className|style|children)$/]",
        "message": "<ResearchRow> doesn't accept that prop. Declared props: title, href, authors, topics, date."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|height|key|ref|className|style|children)$/]",
        "message": "<TrustLogo> doesn't accept that prop. Declared props: src, alt, height."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
